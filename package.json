{
  "name": "cornerstone",
  "version": "1.0.0",
  "description": "Cornerstone — Flow rules, SDUI builder, and Figma plugin management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "plugin:build": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es6",
    "plugin:watch": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es6 --watch",
    "start": "python3 -m http.server 8085",
    "tunnel": "ssh -o StrictHostKeyChecking=no -R 80:localhost:8085 serveo.net",
    "deploy": "npx vercel --prod"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jszip": "^3.10.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "*",
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.20.0",
    "sass": "^1.101.0",
    "terser": "^5.49.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  }
}
